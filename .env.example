# Copy to secret.env and fill in. secret.env is gitignored; this file is not.
#
#   cp .env.example secret.env
#
# FRED API key -- free, register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Absolute path to where the data lake lives. Must be OUTSIDE the repo.
# Expect ~2 GB for the Sample dataset once curated; raw text is processed one
# vintage at a time and deleted, so peak usage stays well under that plus ~500 MB.
DATA_ROOT=/Users/yuyaogawa/Working/loan_forecast_data

# Layout version of the Freddie Mac file spec the raw files conform to.
# See config/schemas/ for the available versions.
FREDDIE_SCHEMA_VERSION=47